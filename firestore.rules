rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper authentication functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Documents & all subcollections (notes, readiness progress, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Protect all nested user subcollections strictly for the owner
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Fallback: Default deny any unmatched document
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
